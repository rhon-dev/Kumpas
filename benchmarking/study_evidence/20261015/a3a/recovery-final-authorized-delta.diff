+                    android.database.Cursor.FIELD_TYPE_INTEGER -> cursor.getLong(i)
+                    android.database.Cursor.FIELD_TYPE_FLOAT -> cursor.getDouble(i)
+                    else -> cursor.getString(i)
+                }) }
+            })
+        }
+        return result
+    }
