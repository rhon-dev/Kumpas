+def safe_path(value):
+    if type(value) is not str:
+        raise ValueError('INVALID_PATH')
+    path = Path(value)
+    if not path.is_absolute() or '..' in path.parts or any(p.is_symlink() for p in (path, *path.parents)):
+        raise ValueError('INVALID_PATH')
+    return path
