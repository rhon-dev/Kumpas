+def assert_resident(path):
+    # macOS SF_DATALESS (placeholder): don't trigger unbounded cloud hydration.
+    if getattr(path.stat(),'st_flags',0) & 0x40000000:
+        raise ValueError('SOURCE_NOT_RESIDENT')
+
