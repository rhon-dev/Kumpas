+"""Paired-frame parity checks, without making an anatomical claim."""
+import copy
+import hashlib
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from pipeline_parity import (compare_vectors, write_frames, select_frame_indices,
+                             generate_python_reference, prepare_video)
+
+
+class ParityTests(unittest.TestCase):
+    def _frame(self, index, digest, value, left=True):
+        return {"index": index, "sha256": hashlib.sha256(digest.encode()).hexdigest(), "features": [value] * 258,
+                "pose_seen": True, "left_seen": left, "right_seen": False}
+
+    def test_finite_extremes_reject_nonfinite_arithmetic_without_warnings(self):
+        import warnings
+        # Finite operands: subtraction, within-block reduction, then a
+        # reduction that overflows only when multiple frames are aggregated.
+        for value, other, count in ((1e308, -1e308, 1), (1e308, 0.0, 1),
+                                    (1e306, 0.0, 4)):
+            for strict in (False, True):
+                with self.subTest(value=value, other=other, count=count, strict=strict):
+                    ref, app = self._extreme_documents(value, other, count, strict)
+                    with warnings.catch_warnings(record=True) as caught:
+                        warnings.simplefilter('always')
+                        with self.assertRaisesRegex(ValueError, '^nonfinite comparison arithmetic$'):
+                            compare_vectors(ref, app, require_clip_binding=strict)
+                    self.assertEqual(caught, [])
+
+    def _extreme_documents(self, value, other, count=1, bound=True):
+        ref = {'schema': 'kumpas-feature-reference-v1',
+               'frames': [self._frame(i, str(i), value) for i in range(count)]}
+        app = {'schema': 'kumpas-android-replay-v1',
+               'frames': [self._frame(i, str(i), other) for i in range(count)]}
+        if bound:
+            binding = {'schema': 'kumpas-clip-binding-v1', 'clip_id': 'clips_22_14.npz',
+                       'source_video_sha256': 'a' * 64, 'replay_manifest_sha256': 'b' * 64}
+            ref['fixture_binding'] = copy.deepcopy(binding)
+            app['fixture_binding'] = copy.deepcopy(binding)
+        return ref, app
+
+    def test_compare_cli_overflow_is_fixed_json_and_preserves_prior_output(self):
+        import json
+        import subprocess
+        for value, other, count in ((1e308, -1e308, 1), (1e308, 0.0, 1), (1e306, 0.0, 4)):
+            for legacy in (False, True):
+                with self.subTest(value=value, other=other, count=count, legacy=legacy):
+                    with tempfile.TemporaryDirectory() as temp:
+                        root = Path(temp)
+                        ref, app = self._extreme_documents(value, other, count, not legacy)
+                        for name, document in (('python', ref), ('android', app)):
+                            (root / (name + '.json')).write_text(json.dumps(document, allow_nan=False))
+                        output = root / 'report.json'
+                        command = [sys.executable, '-B', '-E', str(Path(__file__).with_name('pipeline_parity.py')),
+                                   'compare', str(root / 'python.json'), str(root / 'android.json'), str(output)]
+                        if legacy:
+                            command.append('--legacy-frame-only')
+                        for existing in (False, True):
+                            if existing:
+                                output.write_bytes(b'SYNTHETIC SENTINEL')
+                            result = subprocess.run(command, capture_output=True, text=True)
+                            self.assertNotEqual(result.returncode, 0)
+                            self.assertEqual(result.stderr, '')
+                            self.assertEqual(json.loads(result.stdout), {'ok': False, 'error': 'comparison_failed'})
+                            self.assertNotIn('Infinity', result.stdout)
+                            if existing:
+                                self.assertEqual(output.read_bytes(), b'SYNTHETIC SENTINEL')
+                            else:
+                                self.assertFalse(output.exists())
+
+    def test_extreme_finite_controls_and_public_cli_strict_json(self):
+        import json
+        import subprocess
+        for value, other, count in ((1e308, 1e308, 1), (1e306, 0.0, 1),
+                                    (1e100, 0.0, 4), (1.0, 0.0, 2)):
+            ref, app = self._extreme_documents(value, other, count)
+            report = compare_vectors(ref, app, require_clip_binding=True)
+            json.dumps(report, allow_nan=False)
+            self.assertEqual(report['block_max_abs']['pose'], abs(value - other))
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            ref, app = self._extreme_documents(1.0, 0.0, 2)
+            for name, document in (('python', ref), ('android', app)):
+                (root / (name + '.json')).write_text(json.dumps(document))
+            result = subprocess.run([sys.executable, '-B', '-E', str(Path(__file__).with_name('pipeline_parity.py')),
+                                     'compare', str(root / 'python.json'), str(root / 'android.json'),
+                                     str(root / 'report.json')], capture_output=True, text=True)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(result.stderr, '')
+            self.assertEqual(json.loads(result.stdout), report)
+            self.assertEqual(json.loads((root / 'report.json').read_text()), report)
+
+    def test_same_frame_comparison_and_explicit_anatomical_unknown(self):
+        ref = {"schema": "kumpas-feature-reference-v1", "frames": [self._frame(0, "abc", 0), self._frame(1, "def", 1)]}
+        app = {"schema": "kumpas-android-replay-v1", "frames": [self._frame(0, "abc", 0), self._frame(1, "def", 2, False)]}
+        report = compare_vectors(ref, app)
+        self.assertEqual(report["matched_frames"], 2)
+        self.assertAlmostEqual(report["block_mae"]["pose"], .5)
+        self.assertEqual(report["presence_disagreements"]["left_seen"], 1)
+        self.assertEqual(report["anatomical_left_right"], "unverified")
+
+    def test_image_digest_mismatch_fails_closed(self):
+        with self.assertRaisesRegex(ValueError, "hash"):
+            compare_vectors({"schema": "kumpas-feature-reference-v1", "frames": [self._frame(0, "one", 0)]},
+                            {"schema": "kumpas-android-replay-v1", "frames": [self._frame(0, "two", 0)]})
+
+    def test_missing_frame_or_wrong_dimension_fails(self):
+        with self.assertRaisesRegex(ValueError, "frame"):
+            compare_vectors({"schema": "kumpas-feature-reference-v1", "frames": [self._frame(0, "same", 0)]}, {"schema": "kumpas-android-replay-v1", "frames": []})
+        bad = self._frame(0, "same", 0)
+        bad["features"] = [0] * 257
+        with self.assertRaisesRegex(ValueError, "258"):
+            compare_vectors({"schema": "kumpas-feature-reference-v1", "frames": [self._frame(0, "same", 0)]}, {"schema": "kumpas-android-replay-v1", "frames": [bad]})
+
+    def test_missing_or_malformed_equal_digests_rejected(self):
+        for digest in (None, "", "abc", "g" * 64, 7, [], True):
+            with self.subTest(digest=digest):
+                ref = {"schema": "kumpas-feature-reference-v1", "frames": [self._frame(0, "same", 0)]}
+                app = copy.deepcopy(ref)
+                for doc in (ref, app):
+                    if digest is None:
+                        doc["frames"][0].pop("sha256")
+                    else:
+                        doc["frames"][0]["sha256"] = digest
+                with self.assertRaisesRegex(ValueError, "invalid frame hash"):
+                    compare_vectors(ref, app)
+
