+        for path in ('folder','alias/input.json'):
+            self.assertEqual(self.run_cli(self.args(input=path))[0],2)
+        os.mkfifo(self.root/'pipe')
+        self.assertEqual(self.run_cli(self.args(input='pipe'))[0],2)
