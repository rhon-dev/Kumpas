+  "setup_id": "",
+  "condition": "",
+  "lux": null,
+  "background": "",
+  "distance_cm": null,
+  "device_fingerprint": "",
+  "chip": "",
+  "ram_gb": null,
+  "apk_sha256": "",
+  "revision": "",
